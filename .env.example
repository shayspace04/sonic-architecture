# Copy to .env.local and fill in real values. Never commit real values.
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=

# --- Qloo quota protection (optional; sane defaults apply) ---
# Server-side application request ceiling for this calendar month (UTC).
# Counted per process; persisted to .qloo-usage.json. Clamped to <=9900
# (the upstream x-month-ratelimit-limit is 10000). Default: 9000.
QLOO_APP_MONTHLY_BUDGET=9000

# Response cache TTLs (seconds). Search: 24h, insights: 12h by default.
QLOO_CACHE_TTL_SEARCH_S=86400
QLOO_CACHE_TTL_INSIGHTS_S=43200
QLOO_CACHE_MAX_ENTRIES=500

# Usage file (relative to cwd). Default: .qloo-usage.json
QLOO_USAGE_FILE=.qloo-usage.json
