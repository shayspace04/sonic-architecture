# =============================================================================
# Sonic Architecture — Environment Variables Configuration
# =============================================================================
# Copy this template to .env.local for local development or set in your cloud host.
# NEVER commit .env.local with real credentials to source control.

# -----------------------------------------------------------------------------
# Qloo Hackathon Taste API Key
# -----------------------------------------------------------------------------
# Personal hackathon API key valid against https://hackathon.api.qloo.com.
# If omitted, Sonic Architecture runs in honest fallback mode with typed fixtures.
QLOO_API_KEY=your_qloo_hackathon_api_key_here

# -----------------------------------------------------------------------------
# Serverless Cache Adapter (Optional)
# -----------------------------------------------------------------------------
# By default, Sonic Architecture uses an in-memory cache adapter that works
# on serverless functions without any external configuration.
# To persist cache across serverless warm restarts, configure Vercel KV or Upstash:
# KV_REST_API_URL=https://your-upstash-instance.upstash.io
# KV_REST_API_TOKEN=your_upstash_rest_token_here
# REDIS_URL=redis://default:token@your-redis-host:6379

# -----------------------------------------------------------------------------
# Site URL (Optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
