{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "lib/qloo/**/*.ts",
    "lib/fallback.ts",
    "lib/types.ts",
    "lib/terms.ts",
    "lib/spatial-rules.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
